# Общие настройки
APP_NAME=RepairService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Настройки БД (postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=repair
DB_USERNAME=repair_user
DB_PASSWORD=secret

# Настройки MySQL для тестов
MYSQL_DB_CONNECTION=mysql
MYSQL_DB_HOST=mysql
MYSQL_DB_PORT=3306
MYSQL_DB_DATABASE=repair_test
MYSQL_DB_USERNAME=repair_user
MYSQL_DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379